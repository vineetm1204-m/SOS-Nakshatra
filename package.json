{
  "name": "sos-safe-orbit-for-satellites",
  "version": "1.0.0",
  "description": "Safe Orbit for Satellites (SOS) — Aerospace Space Situational Awareness and Conjunction Operations Console",
  "main": "server/dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p server/tsconfig.json",
    "lint": "tsc --noEmit -p server/tsconfig.json"
  },
  "keywords": [
    "aerospace",
    "space-situational-awareness",
    "satellite-tracking",
    "conjunction-analysis",
    "orbital-mechanics"
  ],
  "author": "SOS Engineering Team",
  "license": "UNLICENSED",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
